{
  "log": {
    "loglevel": "info",
    "access": "access.log",
    "error": "error.log"
  },
  "inbounds": [
    {
      "port": 444,
      "protocol": "gmess",
      "settings": {
        "clients": [
          {
            "id": "77be4540-b58c-4ad2-9926-ea63445a9b58",
            "security": "gost-28147",
            "experiments": ""
          }
        ],
        "default": {
          "level": 0
        }
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "cert.pem",
              "keyFile": "key.pem"
            }
          ]
        }
      },
      "tag": "gmess-inbound"
